# Escrow DApp — variables de entorno del frontend (web/).
# Copia este fichero a .env.local y rellena los valores. .env.local está gitignored (NO lo commitees).

# --- Secreto SERVER-SIDE (solo lo usa la API route web/app/api/upload-ipfs) ---
# JWT de Pinata. Sacar de https://app.pinata.cloud → API Keys → crear key → copiar el JWT.
# 🇪🇸 NUNCA con prefijo NEXT_PUBLIC_: eso lo expondría al navegador. La subida va server-side.
PINATA_JWT=your-pinata-jwt-here

# --- Público (lectura de memos desde un gateway IPFS) ---
# SÍ es público (solo lee). Si se omite, el código usa https://gateway.pinata.cloud/ipfs/ por defecto.
# Para máxima fiabilidad, usa tu gateway dedicado de Pinata: https://<tu-subdominio>.mypinata.cloud/ipfs/
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Indexer de eventos SERVER-SIDE (solo lo usa la API route web/app/api/timeline) ---
# RPC para escanear logs. 🇪🇸 NOTA: en M8 esto iba en NEXT_PUBLIC_ porque el escaneo era en cliente;
# aquí el indexer es server-side, así que la URL del RPC NO se expone al navegador (sin NEXT_PUBLIC_).
# Local: http://localhost:8545 (default si se omite). Sepolia (Fase 2): https://sepolia.drpc.org (sin key).
LOGS_RPC_URL=http://localhost:8545
# Tamaño de ventana del escaneo paginado (bloques por getLogs). En local da igual (pocos bloques).
# En Sepolia con dRPC el límite práctico es ~9000. Default si se omite: 50000.
LOG_WINDOW_SIZE=50000
